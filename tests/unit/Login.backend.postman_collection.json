    {
      "name": "LOGIN-10 | (TENTATIVE) Repeated failed logins are rate-limited",
      "item": [
        {
          "name": "LOGIN-10 - Failed login attempt (repeats until a 429 or 60 attempts)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_KEY}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{SUPABASE_URL}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{L10_EMAIL}}\", \"password\": \"wrong-password\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('L10_EMAIL', 'ratelimit_' + Date.now() + '_' + (pm.collectionVariables.get('L10_COUNT') || 0) + '@dlsu.edu.ph');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Opt-in: this sends up to 60 requests and may block your IP for a few minutes.",
                  "// Turn it on by setting RUN_RATE_LIMIT_TEST to true in the environment file.",
                  "// The limit is a Supabase setting (default: 30 sign-ins per 5 minutes per IP).",
                  "if (pm.environment.get('RUN_RATE_LIMIT_TEST') !== 'true') {",
                  "  pm.test.skip('LOGIN-10 rate limit (skipped: set RUN_RATE_LIMIT_TEST=true to run it)');",
                  "  return;",
                  "}",
                  "const attempt = Number(pm.collectionVariables.get('L10_COUNT') || 0) + 1;",
                  "pm.collectionVariables.set('L10_COUNT', attempt);",
                  "if (pm.response.code === 429) {",
                  "  pm.test('LOGIN-10 Supabase answers HTTP 429 after ' + attempt + ' failed attempts', () => pm.response.to.have.status(429));",
                  "  pm.collectionVariables.unset('L10_COUNT');",
                  "} else if (attempt < 60) {",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.test('LOGIN-10 Supabase answers HTTP 429 within 60 failed attempts', () => {",
                  "    pm.expect.fail('No 429 after 60 attempts. Is the rate limit disabled or set very high in the Supabase project?');",
                  "  });",
                  "  pm.collectionVariables.unset('L10_COUNT');",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
