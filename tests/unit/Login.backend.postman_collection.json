              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('L04_UNKNOWN_EMAIL', 'nobody_' + Date.now() + '@dlsu.edu.ph');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "const message = body.msg || body.error_description || body.message || '';",
                  "const code = body.error_code || body.error || '';",
                  "pm.test('LOGIN-04 same HTTP status as a wrong password', () => {",
                  "  pm.expect(String(pm.response.code)).to.eql(pm.collectionVariables.get('L04_STATUS'));",
                  "});",
                  "pm.test('LOGIN-04 same error message and error code as a wrong password', () => {",
                  "  pm.expect(message).to.eql(pm.collectionVariables.get('L04_MESSAGE'));",
                  "  pm.expect(code).to.eql(pm.collectionVariables.get('L04_CODE'));",
                  "});",
                  "pm.test('LOGIN-04 the message does not reveal that the account does not exist', () => {",
                  "  pm.expect(message).to.not.match(/not found|does not exist|no user|unknown/i);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
