{
  "info": {
    "name": "The Quiver - Login (BACKEND, Postman / Newman)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "BACKEND rows of sheet '02 - Login'. Order: LOGIN-02, 03, 04, 07, 09, 10, 12, 24, 25.\nLOGIN-16..19 (Google callback) are in tests/unit/Login.backend.oauth-callback.test.ts because Postman cannot produce a Google login code.\nLOGIN-27 (cookie flags) is in the Selenium file because only a real browser creates that cookie.\nRun:  pnpm test:backend"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// The name of the Supabase session cookie, e.g. sb-abcd1234-auth-token (derived from the project URL).",
          "const m = (pm.environment.get('SUPABASE_URL') || '').match(/^https?:\\/\\/([^.\\/:]+)/);",
          "pm.collectionVariables.set('COOKIE_NAME', 'sb-' + (m ? m[1] : 'unknown') + '-auth-token');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "LOGIN-02 | Valid student credentials return a session",
      "item": [
        {
          "name": "LOGIN-02 1/3 - Sign in as the student account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_KEY}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{SUPABASE_URL}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{STUDENT_EMAIL}}\", \"password\": \"{{STUDENT_PASSWORD}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "pm.test('LOGIN-02 sign-in returns 200 and a session', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body.access_token, 'access_token').to.be.a('string').and.have.length.above(10);",
                  "  pm.expect(body.refresh_token, 'refresh_token').to.be.a('string').and.have.length.above(10);",
                  "  pm.expect(body.user.email).to.eql(pm.environment.get('STUDENT_EMAIL').toLowerCase());",
                  "});",
                  "pm.collectionVariables.set('STUDENT_TOKEN', body.access_token);",
                  "pm.collectionVariables.set('STUDENT_ID', body.user && body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "LOGIN-02 2/3 - Student table (is there a Student row?)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_KEY}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{STUDENT_TOKEN}}"
              }
            ],
            "url": "{{SUPABASE_URL}}/rest/v1/Student?select=student_id&student_id=eq.{{STUDENT_ID}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('LOGIN-02 Student rows for this user: 1 (so the app treats it as a student)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.lengthOf(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "LOGIN-02 3/3 - Organization table (is there an Organization row?)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_KEY}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{STUDENT_TOKEN}}"
              }
            ],
            "url": "{{SUPABASE_URL}}/rest/v1/Organization?select=organization_id&organization_id=eq.{{STUDENT_ID}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('LOGIN-02 Organization rows for this user: 0 (so the app treats it as a student)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.lengthOf(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Signs in with the real student test account, then asks the database which profile row exists (this is exactly how src/services/accountService.ts decides the account type)."
    },
    {
      "name": "LOGIN-03 | Wrong password is rejected",
      "item": [
        {
          "name": "LOGIN-03 - Sign in with a wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_KEY}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{SUPABASE_URL}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{STUDENT_EMAIL}}\", \"password\": \"this-is-not-the-password\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "const message = body.msg || body.error_description || body.message || '';",
                  "pm.test('LOGIN-03 wrong password is rejected with HTTP 400 \"Invalid login credentials\"', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(message).to.match(/invalid login credentials/i);",
                  "});",
                  "pm.test('LOGIN-03 no session is returned', () => {",
                  "  pm.expect(body).to.not.have.property('access_token');",
                  "  pm.expect(body).to.not.have.property('refresh_token');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
