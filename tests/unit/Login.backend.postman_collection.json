    {
      "name": "LOGIN-25 | Expired, tampered and malformed tokens are rejected",
      "item": [
        {
          "name": "LOGIN-25 - GET /dashboard with a malformed session cookie",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{COOKIE_NAME}}=garbage"
              }
            ],
            "url": "{{APP_URL}}/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('LOGIN-25 a malformed session cookie is treated as logged out (HTTP 307 to \"/\")', () => {",
                  "  pm.response.to.have.status(307);",
                  "  pm.expect(pm.response.headers.get('Location') || '').to.match(/^https?:\\/\\/[^\\/]+\\/?$/);",
                  "});"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "LOGIN-25 (setup) - Sign in as the student to build a tampered token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_KEY}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{SUPABASE_URL}}/auth/v1/token?grant_type=password",
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{STUDENT_EMAIL}}\", \"password\": \"{{STUDENT_PASSWORD}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const enc = (obj) => CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(obj)))",
                  "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (e) {}",
                  "pm.test('LOGIN-25 (setup) the student signs in', () => pm.response.to.have.status(200));",
                  "",
                  "// Tampered token: a real token whose payload is edited (role -> service_role), old signature kept.",
                  "const parts = body.access_token.split('.');",
                  "let b64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "while (b64.length % 4) b64 += '=';",
                  "const payload = JSON.parse(CryptoJS.enc.Base64.parse(b64).toString(CryptoJS.enc.Utf8));",
                  "payload.role = 'service_role';",
                  "parts[1] = enc(payload);",
                  "pm.collectionVariables.set('TAMPERED_TOKEN', parts.join('.'));",
                  "",
                  "// Expired token: says it expired an hour ago (the signature is fake, so it is invalid anyway).",
                  "const now = Math.floor(Date.now() / 1000);",
                  "pm.collectionVariables.set('EXPIRED_TOKEN', [",
                  "  enc({ alg: 'HS256', typ: 'JWT' }),",
                  "  enc({ role: 'authenticated', sub: '00000000-0000-0000-0000-000000000000', exp: now - 3600 }),",
                  "  'invalid-signature',",
                  "].join('.'));",
                  "pm.collectionVariables.set('MALFORMED_TOKEN', 'garbage');"
                ]
              }
            }
          ]
        },
        {
          "name": "LOGIN-25 - Database with a malformed token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_KEY}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{MALFORMED_TOKEN}}"
              }
            ],
            "url": "{{SUPABASE_URL}}/rest/v1/Student?select=student_id&limit=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('LOGIN-25 the database rejects a malformed token (HTTP 401)', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "LOGIN-25 - Database with an expired token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_KEY}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{EXPIRED_TOKEN}}"
              }
            ],
            "url": "{{SUPABASE_URL}}/rest/v1/Student?select=student_id&limit=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('LOGIN-25 the database rejects an expired token (HTTP 401)', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "LOGIN-25 - Database with a tampered token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{SUPABASE_KEY}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{TAMPERED_TOKEN}}"
              }
            ],
            "url": "{{SUPABASE_URL}}/rest/v1/Student?select=student_id&limit=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('LOGIN-25 the database rejects a tampered token (role edited) (HTTP 401)', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
